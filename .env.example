# API Key (opcional, vacio = sin autenticacion)
# Si se define, todos los endpoints requieren header: X-API-Key: <valor>
S1_API_KEY=

# URL del reporte S1 (stock) desde appweb.cipsa.com.pe
S1_SOURCE1_URL=http://appweb.cipsa.com.pe:8054/AlmacenStock/DownLoadFiles?value=%7B%22linea%22:%22%22,%22porLinea%22:%22tbLinea%22,%22grupo%22:%22%22,%22porGrupo%22:%22tbGrupo%22,%22tipo%22:%22%22,%22porTipo%22:%22tbTipo%22,%22familia%22:%22%22,%22porFamilia%22:%22tbFamilia%22,%22parametroX2%22:%22%22,%22parametroX1%22:%220%22%7D

# URL del reporte S1 sucursales
S1_SOURCE2_URL=http://appweb.cipsa.com.pe:8054/AlmacenStock/DownLoadFiles?value=%7B%22linea%22:%22%22,%22porLinea%22:%22tbLinea%22,%22grupo%22:%22%22,%22porGrupo%22:%22tbGrupo%22,%22tipo%22:%22%22,%22porTipo%22:%22tbTipo%22,%22familia%22:%22%22,%22porFamilia%22:%22tbFamilia%22,%22parametroX2%22:%221%22,%22parametroX1%22:%220%22%7D

# TTL del cache en segundos (default: 900 = 15 min)
S1_CACHE_TTL_SEGUNDOS=900

# Rutas de archivos de cache
S1_CACHE_RUTA=data/stock_cache.json
S1_CACHE_RUTA2=data/stock_cache_sucursales.json
