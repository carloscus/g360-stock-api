# API Key administrativa (upload/catalogo/resumen)
S1_API_KEY=

# API Key de lectura para el frontend estatico.
# Debe ser distinta de S1_API_KEY y solo permite endpoints GET de stock/health.
S1_READ_API_KEY=

# URL del reporte S1 (stock) desde la fuente de datos
# Configurar URL real en Render Dashboard
S1_SOURCE1_URL=https://your-erp-host:port/path/to/report

# URL del reporte S1 sucursales
# Configurar URL real en Render Dashboard
S1_SOURCE2_URL=https://your-erp-host:port/path/to/report?parametro=1

# TTL del cache en segundos (default: 900 = 15 min)
S1_CACHE_TTL_SEGUNDOS=900

# Rutas de archivos de cache
S1_CACHE_RUTA=data/stock_cache.json
S1_CACHE_RUTA2=data/stock_cache_sucursales.json

# CORS - frontend publicado + desarrollo local
S1_CORS_ORIGINS=https://your-frontend.com,http://localhost:3000,http://localhost:5173

# Rate limiting (default: 60 requests/minuto por IP)
S1_RATE_LIMIT=60/minute

# Request timeout en segundos (default: 30)
S1_REQUEST_TIMEOUT=30

# Maximo tamano de XLS descargado en bytes (default: 5MB)
S1_XLS_MAX_BYTES=5242880

# Circuit breaker: fallos consecutivos antes de abrir circuito (default: 3)
S1_CIRCUIT_BREAKER_MAX_FALLOS=3

# Circuit breaker: segundos para resetear despues de abrir (default: 300 = 5 min)
S1_CIRCUIT_BREAKER_RESET_SEG=300
